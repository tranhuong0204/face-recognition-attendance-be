                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "var responseData = pm.response.json();\r",
                  "var data = responseData.data || responseData;\r",
                  "\r",
                  "// Tự động lưu Token vào Environment\r",
                  "if (data.accessToken && data.refreshToken) {\r",
                  "    pm.environment.set(\"accessToken\", data.accessToken);\r",
                  "    pm.environment.set(\"refreshToken\", data.refreshToken);\r",
                  "    console.log(\"Tokens saved successfully!\");\r",
